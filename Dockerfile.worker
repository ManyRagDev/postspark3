FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates fonts-liberation fonts-noto-core fonts-noto-color-emoji && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.4.1 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY --chown=node:node . .
RUN pnpm build:review-renderer && chown node:node /app && chown -R node:node dist
USER node
ENV NODE_ENV=production GENERATION_WORKER_MODE=external REVIEW_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
CMD ["node", "--import", "tsx", "server/ai/workflows/generationWorker.ts"]
