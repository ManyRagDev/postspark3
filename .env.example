# PostSpark Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: OAuth Configuration (Manus/Claude)
# ============================================
# URL do portal de autenticação OAuth
VITE_OAUTH_PORTAL_URL=https://auth.manus.im

# ID do aplicativo registrado no portal OAuth
VITE_APP_ID=your-app-id-here

# ============================================
# REQUIRED: AI/LLM API (Forge API)
# ============================================
# Chave da API da Manus (Forge) para geração de conteúdo
BUILT_IN_FORGE_API_KEY=your-forge-api-key-here

# OpenRouter PAYG e o provedor principal para texto, vision criativa e imagem.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_SITE_URL=https://postspark.app
OPENROUTER_APP_NAME=PostSpark
# Jev pré-seleciona até 12 opções antes da LLM; usa a mesma chave OpenRouter.
OPENROUTER_DESIGN_SELECTION_MODEL=typesafe/jev-1.13
# Override global/rollback: usado quando uma rota especifica nao for definida.
OPENROUTER_TEXT_MODEL=openai/gpt-5-mini
# Uma chamada normal usa somente a rota correspondente; estes modelos nao rodam em ensemble.
OPENROUTER_STATIC_MODEL=google/gemini-3.8-flash
OPENROUTER_CAROUSEL_MODEL=google/gemini-3.8-flash
OPENROUTER_QUALITY_REVISION_MODEL=openai/gpt-5.4-mini
OPENROUTER_CONTENT_STRATEGY_MODEL=z-ai/glm-5.3-flash
OPENROUTER_BRIEF_INTERPRETATION_MODEL=google/gemini-3.8-flash
OPENROUTER_EVALUATION_MODEL=z-ai/glm-5.3-flash
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash
OPENROUTER_DESIGN_ANALYSIS_MODEL=openai/gpt-4o
# Modelo vision do MVP privado /admin2; independente do laboratorio completo.
OPENROUTER_DESIGN_RECREATION_MODEL=deepseek/deepseek-v4.1-flash
# Opcional: diretorio local com eng.traineddata.gz e por.traineddata.gz para o OCR do laboratorio.
# Sem ele, tesseract.js baixa os idiomas do CDN na primeira analise e usa cache depois.
# DESIGN_DNA_OCR_LANG_PATH=/caminho/absoluto/para/tessdata
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_V5_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_PLATFORM_FEE_PERCENT=5.5

# Groq fica reservado a microcopy e vision rapida. Gemini direto e fallback.
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Estimativa de custo persistida em generation_runs
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Rollout e privacidade do pipeline de IA
AI_SITE_INTELLIGENCE_ENABLED=true
AI_LLM_JUDGE_ENABLED=false
AI_SEMANTIC_EMBEDDINGS_ENABLED=true
AI_MODEL_FALLBACK_ENABLED=true
# retries adicionais para 429/5xx/timeout antes do fallback
LLM_TRANSIENT_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=700
LLM_REQUEST_TIMEOUT_MS=90000
# false persiste hashes, metricas e metadados, mas nao prompts/outputs brutos
AI_TRACE_STORE_CONTENT=false
# habilita retorno efemero de prompts/respostas para o painel de auditoria
AI_UI_DEBUG_ENABLED=false

# URL da API Forge (opcional - usa default se não definido)
# BUILT_IN_FORGE_API_URL=https://forge.manus.im

# Supabase backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# OPTIONAL: Database Configuration
# ============================================
# URL do banco de dados MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/postspark

# ============================================
# OPTIONAL: Server Configuration
# ============================================
# Porta do servidor (default: 3000)
# PORT=3000

# Segredo para assinatura de cookies/JWT
# JWT_SECRET=your-jwt-secret-here

# URL do servidor OAuth (backend)
# OAUTH_SERVER_URL=https://auth.manus.im

# OpenID do proprietário/admin
# OWNER_OPEN_ID=your-owner-openid

# ============================================
# NEW: Railway Screenshot Microservice Configuration
# ============================================
# URL base do microsserviço de screenshot (ex: https://service.up.railway.app)
SCREENSHOT_SERVICE_URL=https://screenshot-service-production-2177.up.railway.app

# Arsenal V2: governs new server selections only. Saved posts/assets remain readable.
DESIGN_ARSENAL_V2_MODE=off

# Historical component/admin assembly feature gate. Canonical generation uses
# published whole designs and its own catalog readiness check.
# includeDraftDesigns includes drafts only for administrator previews (assemblyPilot is a legacy alias).
# Automatic mixing of fragments is retired; saved historical assemblies remain readable.
# Set off to stop new selections without affecting saved documents and private asset grants.
COMPONENT_ARSENAL_MODE=admin

# Canonical durable generation: migrations 0034 through 0037.
# Local dev uses local-demand; no executor is started while idle. Production stays external.
# GENERATION_WORKER_MODE=external
# External worker needs the renderer bundle and Chromium (see Dockerfile.worker).
# REVIEW_RENDERER_BUNDLE=dist/review-renderer/renderer.js
# REVIEW_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# Must accept image inputs. Text-only evaluation keeps its existing model.
OPENROUTER_PROPOSAL_REVIEW_MODEL=google/gemini-3.8-flash
# Same budget for review wrapper and transport; bounded by request deadline.
PROPOSAL_REVIEW_TIMEOUT_MS=45000

# Pause new requests while compatible readers/workers and curated offers are activated.
GENERATION_ADMISSION_PAUSED=false

# Activate only after 0040/0041/0042 and verified initial catalog publication.
# GENERATION_LOCAL_DEMAND_ENABLED=true
# GENERATION_WORKER_MODE=external preserves the production executor.

# Brand capture uses no Sparks. Enable remote screenshots only when that service
# blocks private destinations on redirects and every browser subrequest.
SCREENSHOT_PUBLIC_NETWORK_ONLY=false
# Optional, existing management access for read-only stored review recovery.
# Does not enable logging/retention. Leave empty when unavailable.
OPENROUTER_RECONCILIATION_KEY=
# Review V9 pins 45s standard / 90s extended and repair, within the 10min deadline.
# Apply incremental 0043 after 0042 with admissions paused during rollout.
