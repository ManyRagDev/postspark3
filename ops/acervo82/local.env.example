# Dedicated local profile. Never copy the main workspace's .env here.
POSTSPARK_ACERVO82_LOCAL=true
NODE_ENV=development
PORT=3182
SUPABASE_URL=http://127.0.0.1:55481
VITE_SUPABASE_URL=http://127.0.0.1:55481
VITE_POSTSPARK_LOCAL_AUTH=email
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55482/postgres
# Fill using the credentials returned by the LOCAL Supabase instance.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Keep paused until schema, sources, assets and the new catalogue are validated.
GENERATION_ADMISSION_PAUSED=true
DESIGN_RETRIEVAL_DIRECTORY=.postspark-local/design-retrieval
GENERATION_LOCAL_DEMAND_ENABLED=false
GENERATION_WORKER_MODE=local-demand
GENERATION_STRATEGY_VERSION=2
GENERATION_LOCAL_CATALOG_REVISION=
COMPONENT_ARSENAL_MODE=admin
DESIGN_ARSENAL_V2_MODE=off
AI_SITE_INTELLIGENCE_ENABLED=false
AI_SEMANTIC_EMBEDDINGS_ENABLED=false
AI_MODEL_FALLBACK_ENABLED=false
