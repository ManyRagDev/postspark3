{
  "name": "postspark",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test:egress": "vitest run server/routers/catalogAdmission.test.ts server/routers/generation.test.ts server/ai/workflows/generationProgress.postgres.test.ts server/ai/workflows/generationStore.test.ts server/db.snapshot.test.ts client/src/pages/StudioApp/StudioAppV2BPage.generation.test.tsx client/src/pages/History.v5.test.tsx --maxWorkers=2 --minWorkers=1",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && cross-env esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --define:process.env.POSTSPARK_API_WITHOUT_LOCAL_EMBEDDINGS='\"1\"' --outfile=api/index.js && pnpm build:review-renderer",
    "start": "cross-env NODE_ENV=production node api/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:local-demand": "node scripts/testing/run-local-demand.mjs",
    "diagnose:start": "node --import tsx scripts/diagnostics/network.ts start",
    "diagnose:stop": "node --import tsx scripts/diagnostics/network.ts stop",
    "diagnose:report": "node --import tsx scripts/diagnostics/network.ts report",
    "diagnose:calibrate": "node --import tsx scripts/diagnostics/calibrate.ts",
    "harness": "tsx harness/run.ts",
    "designs:intake": "node --import tsx harness/completeDesigns/intake.ts",
    "designs:build": "node --import tsx harness/completeDesigns/build.ts",
    "harness:corpus": "tsx harness/pullCorpus.ts",
    "benchmark:editorial": "tsx --env-file=.env server/benchmarks/editorialModels/run.ts",
    "evaluate:editorial:offline": "node --import tsx scripts/evaluateEditorialReplay.ts",
    "benchmark:editorial:summary": "tsx server/benchmarks/editorialModels/summarize.ts",
    "editorial:provision": "node scripts/provisionEditorialModel.mjs",
    "editorial:affinity": "node --import tsx scripts/editorialAffinity.ts",
    "editorial:catalog": "node --import tsx harness/completeDesigns/importEditorialCatalog.ts",
    "verify:runtime": "tsx --env-file=.env server/verifyRuntime.ts",
    "verify:e2e": "node --env-file-if-exists=.env --import tsx scripts/inspectGenerationRun.ts",
    "generation:worker": "tsx --env-file-if-exists=.env server/ai/workflows/generationWorker.ts",
    "build:review-renderer": "node scripts/build-review-renderer.mjs",
    "predev": "pnpm build:review-renderer",
    "generation:setup-browser": "playwright-core install chromium",
    "acervo82:inventory": "node --require ./scripts/testing/block-network.cjs scripts/acervo82/inventory.mjs --write",
    "acervo82:verify": "node --require ./scripts/testing/block-network.cjs scripts/acervo82/inventory.mjs",
    "acervo82:test": "node --require ./scripts/testing/block-network.cjs --test scripts/acervo82/preparation.test.mjs",
    "acervo82:auth:setup": "node scripts/acervo82/auth.mjs setup",
    "acervo82:auth:verify": "node scripts/acervo82/auth.mjs verify",
    "acervo82:bootstrap": "node scripts/acervo82/bootstrap.mjs",
    "acervo82:fixtures": "node scripts/acervo82/run.mjs fixtures",
    "acervo82:journey": "node scripts/acervo82/run.mjs verify",
    "acervo82:init": "node scripts/acervo82/local.mjs init",
    "acervo82:doctor": "node scripts/acervo82/local.mjs doctor",
    "acervo82:dev": "pnpm build:review-renderer && node scripts/acervo82/local.mjs dev",
    "acervo82:db:start": "node scripts/acervo82/supabase.mjs start",
    "acervo82:db:status": "node scripts/acervo82/supabase.mjs status",
    "acervo82:db:stop": "node scripts/acervo82/supabase.mjs stop",
    "acervo82:db:env": "node scripts/acervo82/supabase.mjs env",
    "acervo82:pilot:prepare": "node scripts/acervo82/pilot/prepare.mjs",
    "acervo82:pilot:author": "node --import tsx scripts/acervo82/pilot/author.ts",
    "acervo82:pilot:stage": "node --import tsx scripts/acervo82/pilot/local.mjs stage",
    "acervo82:pilot:configure": "node --import tsx scripts/acervo82/pilot/local.mjs configure",
    "acervo82:pilot:dev": "node --import tsx scripts/acervo82/pilot/local.mjs dev",
    "acervo82:pilot:verify": "node --import tsx scripts/acervo82/pilot/local.mjs test",
    "acervo82:pilot:review": "node --import tsx scripts/acervo82/pilot/local.mjs review",
    "acervo82:pilot:smoke": "node --import tsx scripts/acervo82/pilot/local.mjs smoke",
    "acervo82:pilot:audit": "node --import tsx scripts/acervo82/pilot/local.mjs audit",
    "acervo82:retrieval:model": "node scripts/provisionEditorialModel.mjs retrieval-e5 .postspark-local/design-retrieval/model",
    "acervo82:retrieval:index": "node scripts/acervo82/retrieval.mjs",
    "acervo82:retrieval:verify": "node scripts/acervo82/retrieval.mjs --verify",
    "acervo82:full:author": "node --import tsx scripts/acervo82/full/author.ts",
    "acervo82:full:verify": "node --import tsx scripts/acervo82/full/verify.ts",
    "acervo82:full:stage": "POSTSPARK_ACERVO82_CAMPAIGN=full node --import tsx scripts/acervo82/pilot/local.mjs stage",
    "acervo82:full:configure": "POSTSPARK_ACERVO82_CAMPAIGN=full node --import tsx scripts/acervo82/pilot/local.mjs configure",
    "acervo82:full:dev": "POSTSPARK_ACERVO82_CAMPAIGN=full node --import tsx scripts/acervo82/pilot/local.mjs dev",
    "acervo82:full:smoke": "POSTSPARK_ACERVO82_CAMPAIGN=full node --import tsx scripts/acervo82/pilot/local.mjs smoke",
    "acervo82:full:journeys": "POSTSPARK_ACERVO82_CAMPAIGN=full node --import tsx scripts/acervo82/pilot/local.mjs journeys",
    "acervo82:full:retrieval": "POSTSPARK_ACERVO82_CAMPAIGN=full node --import tsx scripts/acervo82/pilot/local.mjs retrieval",
    "acervo82:full:review-dev": "POSTSPARK_ACERVO82_CAMPAIGN=full node --import tsx scripts/acervo82/pilot/local.mjs verify-dev",
    "test:motor": "node scripts/testing/run-motor.mjs",
    "motor:preflight": "tsx scripts/motorPreflight.ts"
  },
